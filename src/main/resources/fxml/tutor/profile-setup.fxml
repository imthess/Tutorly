<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tutorly.controller.tutor.TutorProfileSetupController"
            styleClass="root">

    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="18"
                        right="30"
                        bottom="18"
                        left="30"/>
            </padding>

            <Button text="← Back"
                    onAction="#handleBack"
                    styleClass="text-button"/>

            <Label text="Tutor Profile"
                   styleClass="app-title"/>

        </HBox>

    </top>

    <center>

        <VBox spacing="18"
              maxWidth="700"
              alignment="CENTER">

            <padding>
                <Insets top="35"
                        right="40"
                        bottom="35"
                        left="40"/>
            </padding>

            <Label fx:id="titleLabel"
                   text="Complete Tutor Profile"
                   styleClass="page-title"/>

            <Label text="Keep your professional information updated."
                   styleClass="section-title"/>

            <TextField fx:id="qualificationsField"
                       promptText="Qualifications"
                       maxWidth="650"/>

            <TextField fx:id="experienceField"
                       promptText="Experience in years"
                       maxWidth="650"/>

            <TextField fx:id="hourlyRateField"
                       promptText="Hourly rate"
                       maxWidth="650"/>

            <TextArea fx:id="bioArea"
                      promptText="Tell students about yourself..."
                      prefRowCount="7"
                      wrapText="true"
                      maxWidth="650"/>

            <Label fx:id="messageLabel"
                   wrapText="true"/>

            <HBox spacing="12"
                  alignment="CENTER">

                <Button text="Save Changes"
                        onAction="#handleSaveProfile"
                        styleClass="primary-button"/>

                <Button text="Back to Dashboard"
                        onAction="#handleBack"/>

            </HBox>

            <Button text="Logout"
                    onAction="#handleLogout"
                    styleClass="text-button"/>

        </VBox>

    </center>

</BorderPane>

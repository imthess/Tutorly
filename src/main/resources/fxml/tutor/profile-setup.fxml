<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tutorly.controller.tutor.TutorProfileSetupController"
      alignment="CENTER"
      spacing="12"
      prefWidth="1000"
      prefHeight="700"
      styleClass="root">

    <padding>
        <Insets top="30"
                right="40"
                bottom="30"
                left="40"/>
    </padding>

    <Label text="Complete Your Tutor Profile"
           styleClass="page-title"/>

    <Label text="Please provide your information before continuing."
           styleClass="section-title"/>

    <TextField fx:id="qualificationsField"
               promptText="Qualifications"
               maxWidth="500"/>

    <TextField fx:id="experienceField"
               promptText="Experience in years"
               maxWidth="500"/>

    <TextField fx:id="hourlyRateField"
               promptText="Hourly rate"
               maxWidth="500"/>

    <TextArea fx:id="bioArea"
              promptText="Tell students about yourself..."
              prefRowCount="6"
              wrapText="true"
              maxWidth="500"/>

    <Button text="Continue"
            onAction="#handleSaveProfile"
            styleClass="primary-button"
            maxWidth="500"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           maxWidth="500"/>

    <Button text="Logout"
            onAction="#handleLogout"
            styleClass="text-button"/>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tutorly.controller.tutor.TutorProfileSetupController"
            prefWidth="1000"
            prefHeight="700"
            styleClass="root">

    <top>

        <HBox alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="18"
                        right="30"
                        bottom="18"
                        left="30"/>
            </padding>

            <Label text="Tutorly"
                   styleClass="app-title"/>

            <Label text="Tutor Profile"
                   styleClass="dashboard-heading"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    styleClass="text-button"/>

        </HBox>

    </top>


    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="dashboard-scroll">

            <VBox alignment="TOP_CENTER"
                  spacing="20">

                <padding>
                    <Insets top="35"
                            right="40"
                            bottom="40"
                            left="40"/>
                </padding>


                <Label text="Build Your Tutor Profile"
                       styleClass="page-title"/>

                <Label text="Give students enough information to understand your expertise and teaching style."
                       wrapText="true"
                       styleClass="dashboard-subtitle"/>


                <VBox spacing="14"
                      maxWidth="700"
                      styleClass="form-card">

                    <VBox spacing="7">

                        <Label text="Qualifications"
                               styleClass="field-label"/>

                        <TextField fx:id="qualificationsField"
                                   promptText="Example: BSc in Computer Science"/>

                    </VBox>


                    <VBox spacing="7">

                        <Label text="Teaching Experience"
                               styleClass="field-label"/>

                        <TextField fx:id="experienceField"
                                   promptText="Experience in years"
                                   maxWidth="300"/>

                    </VBox>


                    <VBox spacing="7">

                        <Label text="Hourly Rate"
                               styleClass="field-label"/>

                        <TextField fx:id="hourlyRateField"
                                   promptText="Example: 500"
                                   maxWidth="300"/>

                    </VBox>


                    <VBox spacing="7">

                        <Label text="About You"
                               styleClass="field-label"/>

                        <TextArea fx:id="bioArea"
                                  promptText="Tell students about your teaching experience, subjects and teaching style..."
                                  prefRowCount="7"
                                  wrapText="true"/>

                    </VBox>


                    <Label fx:id="messageLabel"
                           wrapText="true"
                           styleClass="error-label"/>


                    <Button text="Save &amp; Continue"
                            onAction="#handleSaveProfile"
                            styleClass="primary-button"
                            maxWidth="700"/>

                </VBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tutorly.controller.tutor.AvailabilityController"
            styleClass="root">

    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="18"
                        right="30"
                        bottom="18"
                        left="30"/>
            </padding>

            <Button text="← Back"
                    onAction="#handleBack"
                    styleClass="text-button"/>

            <Label text="Manage Availability"
                   styleClass="app-title"/>

        </HBox>

    </top>

    <center>

        <VBox spacing="22">

            <padding>
                <Insets top="30"
                        right="40"
                        bottom="30"
                        left="40"/>
            </padding>

            <Label text="Set your teaching schedule"
                   styleClass="page-title"/>

            <GridPane hgap="12"
                      vgap="12">

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <ComboBox fx:id="dayComboBox"
                          promptText="Day"
                          GridPane.columnIndex="0"/>

                <ComboBox fx:id="subjectComboBox"
                          promptText="Subject"
                          GridPane.columnIndex="1"/>

                <ComboBox fx:id="startComboBox"
                          promptText="Start"
                          GridPane.columnIndex="2"/>

                <ComboBox fx:id="endComboBox"
                          promptText="End"
                          GridPane.columnIndex="3"/>

                <TextArea fx:id="descriptionField"
                          promptText="What will you teach during this time?"
                          prefHeight="70"
                          wrapText="true"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1"
                          GridPane.columnSpan="3"/>

                <Button fx:id="saveButton"
                        text="Add Availability"
                        onAction="#handleSaveAvailability"
                        styleClass="secondary-button"
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="1"/>

            </GridPane>

            <Label fx:id="messageLabel"
                   wrapText="true"/>

            <TableView fx:id="availabilityTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="dayColumn"
                                 text="Day"
                                 prefWidth="130"/>

                    <TableColumn fx:id="subjectColumn"
                                 text="Subject"
                                 prefWidth="240"/>

                    <TableColumn fx:id="startColumn"
                                 text="Start"
                                 prefWidth="110"/>

                    <TableColumn fx:id="endColumn"
                                 text="End"
                                 prefWidth="110"/>

                    <TableColumn fx:id="descriptionColumn"
                                 text="What I'll Teach"
                                 prefWidth="300"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120"/>

                </columns>

            </TableView>

            <HBox spacing="12">

                <Button text="Edit Selected"
                        onAction="#handleEditAvailability"/>

                <Button text="Enable / Disable"
                        onAction="#handleToggleAvailability"/>

                <Button text="Delete"
                        onAction="#handleDeleteAvailability"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>

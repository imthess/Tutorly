<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tutorly.controller.tutor.BookingRequestsController"
            prefWidth="1100"
            prefHeight="700"
            styleClass="root">

    <top>
        <VBox spacing="6">
            <padding>
                <Insets top="25" right="30" bottom="20" left="30"/>
            </padding>

            <Label text="Booking Requests"
                   styleClass="page-title"/>

            <Label text="Review students who want to enroll with you."
                   styleClass="section-title"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="10" right="30" bottom="20" left="30"/>
            </padding>

            <TableView fx:id="bookingTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="studentColumn"
                                 text="Student"
                                 prefWidth="190"/>

                    <TableColumn fx:id="subjectColumn"
                                 text="Subject"
                                 prefWidth="170"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="120"/>

                    <TableColumn fx:id="timeColumn"
                                 text="Time"
                                 prefWidth="100"/>

                    <TableColumn fx:id="durationColumn"
                                 text="Minutes"
                                 prefWidth="90"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="130"/>

                </columns>
            </TableView>

            <Label fx:id="messageLabel"
                   wrapText="true"/>

            <HBox spacing="12">

                <Button text="Accept"
                        onAction="#handleAccept"
                        styleClass="primary-button"/>

                <Button text="Reject"
                        onAction="#handleReject"
                        styleClass="secondary-button"/>

                <Button text="Back"
                        onAction="#handleBack"
                        styleClass="text-button"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>

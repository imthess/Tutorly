<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tutorly.controller.tutor.TutorDashboardController"
      alignment="TOP_CENTER"
      spacing="20"
      prefWidth="1000"
      prefHeight="700"
      styleClass="root">

    <padding>
        <Insets top="30"
                right="40"
                bottom="30"
                left="40"/>
    </padding>

    <Label text="Tutor Dashboard"
           styleClass="page-title"/>

    <Label fx:id="welcomeLabel"
           text="Welcome"
           styleClass="section-title"/>

    <Separator/>

    <Label text="Tutor Management"
           styleClass="section-title"/>

    <Button text="Manage Subjects"
            maxWidth="400"
            styleClass="primary-button"/>

    <Button text="Manage Availability"
            maxWidth="400"/>

    <Button text="Booking Requests"
            maxWidth="400"/>

    <Button text="Online Classes"
            maxWidth="400"/>

    <Button text="Learning Materials"
            maxWidth="400"/>

    <Button text="My Profile"
            maxWidth="400"/>

    <Separator/>

    <Button text="Logout"
            onAction="#handleLogout"/>

</VBox>
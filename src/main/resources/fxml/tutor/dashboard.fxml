<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tutorly.controller.tutor.TutorDashboardController"
            prefWidth="1100"
            prefHeight="750"
            styleClass="root">

    <top>

        <HBox spacing="20"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="18"
                        right="30"
                        bottom="18"
                        left="30"/>
            </padding>

            <Label text="Tutorly"
                   styleClass="app-title"/>

            <Label text="Tutor Dashboard"
                   styleClass="dashboard-heading"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    styleClass="text-button"/>

        </HBox>

    </top>


    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="dashboard-scroll">

            <VBox spacing="24"
                  styleClass="dashboard-content">

                <padding>
                    <Insets top="30"
                            right="40"
                            bottom="40"
                            left="40"/>
                </padding>


                <VBox spacing="6">

                    <Label fx:id="welcomeLabel"
                           text="Welcome"
                           styleClass="page-title"/>

                    <Label text="Manage your tutoring profile, classes and teaching activities."
                           styleClass="dashboard-subtitle"/>

                </VBox>


                <VBox spacing="14"
                      styleClass="profile-summary-card">

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">

                        <Label text="Tutor Profile"
                               styleClass="card-title"/>

                        <HBox HBox.hgrow="ALWAYS"/>

                        <Label fx:id="profileStatusLabel"
                               text="Profile status"
                               styleClass="status-label"/>

                        <Button text="Edit Profile"
                                onAction="#handleEditProfile"
                                styleClass="secondary-button"/>

                    </HBox>


                    <HBox spacing="25">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="Qualifications"
                                   styleClass="field-label"/>

                            <Label fx:id="qualificationsLabel"
                                   text="-"
                                   wrapText="true"
                                   styleClass="profile-value"/>

                        </VBox>


                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="Experience"
                                   styleClass="field-label"/>

                            <Label fx:id="experienceLabel"
                                   text="-"
                                   styleClass="profile-value"/>

                        </VBox>


                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="Hourly Rate"
                                   styleClass="field-label"/>

                            <Label fx:id="hourlyRateLabel"
                                   text="-"
                                   styleClass="profile-value"/>

                        </VBox>

                    </HBox>


                    <VBox spacing="5">

                        <Label text="Bio"
                               styleClass="field-label"/>

                        <Label fx:id="bioLabel"
                               text="-"
                               wrapText="true"
                               styleClass="profile-value"/>

                    </VBox>

                </VBox>


                <Label text="Tutor Management"
                       styleClass="section-title"/>


                <HBox spacing="18">

                    <VBox spacing="12"
                          styleClass="dashboard-card"
                          HBox.hgrow="ALWAYS">

                        <Label text="Subjects"
                               styleClass="card-title"/>

                        <Label text="Choose and manage the subjects you teach."
                               wrapText="true"
                               styleClass="card-description"/>

                        <Button text="Manage Subjects"
                                onAction="#handleManageSubjects"
                                styleClass="primary-button"/>

                    </VBox>


                    <VBox spacing="12"
                          styleClass="dashboard-card"
                          HBox.hgrow="ALWAYS">

                        <Label text="Availability"
                               styleClass="card-title"/>

                        <Label text="Set the times when students can book your sessions."
                               wrapText="true"
                               styleClass="card-description"/>

                        <Button text="Manage Availability"
                                onAction="#handleAvailability"/>

                    </VBox>

                </HBox>


                <HBox spacing="18">

                    <VBox spacing="12"
                          styleClass="dashboard-card"
                          HBox.hgrow="ALWAYS">

                        <Label text="Booking Requests"
                               styleClass="card-title"/>

                        <Label text="Review incoming tutoring requests and manage your sessions."
                               wrapText="true"
                               styleClass="card-description"/>

                        <Button text="View Requests"
                                onAction="#handleBookings"/>

                    </VBox>


                    <VBox spacing="12"
                          styleClass="dashboard-card"
                          HBox.hgrow="ALWAYS">

                        <Label text="Online Classes"
                               styleClass="card-title"/>

                        <Label text="Start and manage live Jitsi tutoring classes."
                               wrapText="true"
                               styleClass="card-description"/>

                        <Button text="Open Online Class"
                                onAction="#handleOnlineClasses"
                                styleClass="primary-button"/>

                    </VBox>

                </HBox>


                <HBox spacing="18">

                    <VBox spacing="12"
                          styleClass="dashboard-card"
                          HBox.hgrow="ALWAYS">

                        <Label text="Learning Materials"
                               styleClass="card-title"/>

                        <Label text="Organize materials for your students."
                               wrapText="true"
                               styleClass="card-description"/>

                        <Button text="Manage Materials"
                                onAction="#handleLearningMaterials"/>

                    </VBox>

                </HBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>

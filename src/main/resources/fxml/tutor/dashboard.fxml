<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.tutorly.controller.tutor.TutorDashboardController"
        fitToWidth="true">

    <VBox spacing="15">

        <padding>
            <Insets top="30"
                    right="40"
                    bottom="30"
                    left="40"/>
        </padding>

        <Label
                text="Tutor Dashboard"
                styleClass="page-title"/>

        <Label
                fx:id="welcomeLabel"
                text="Welcome"
                styleClass="section-title"/>

        <Separator/>

        <Label
                text="Tutor Profile"
                styleClass="section-title"/>

        <Label text="Qualifications"/>

        <TextField
                fx:id="qualificationsField"
                promptText="Example: BSc in Computer Science"/>

        <Label text="Experience (years)"/>

        <TextField
                fx:id="experienceField"
                promptText="Example: 3"/>

        <Label text="Hourly Rate"/>

        <TextField
                fx:id="hourlyRateField"
                promptText="Example: 500"/>

        <Label text="Bio"/>

        <TextArea
                fx:id="bioArea"
                promptText="Tell students about yourself..."
                prefRowCount="6"
                wrapText="true"/>

        <Button
                text="Save Profile"
                onAction="#handleSaveProfile"
                styleClass="primary-button"/>

        <Label
                fx:id="messageLabel"/>

        <Separator/>

        <Label
                text="Coming Next"
                styleClass="section-title"/>

        <Label text="• Manage subjects"/>

        <Label text="• Manage availability"/>

        <Label text="• View booking requests"/>

        <Label text="• Start online classes"/>

        <Label text="• Upload learning materials"/>

        <Separator/>

        <Button
                text="Logout"
                onAction="#handleLogout"/>

    </VBox>

</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tutorly.controller.tutor.OnlineClassController"
      alignment="TOP_CENTER"
      spacing="15"
      prefWidth="1000"
      prefHeight="700"
      styleClass="root">

    <padding>
        <Insets top="30"
                right="40"
                bottom="30"
                left="40"/>
    </padding>

    <Label text="Online Class"
           styleClass="page-title"/>

    <Label text="Tutorly Live Classroom"
           styleClass="section-title"/>

    <Separator/>

    <Label fx:id="statusLabel"
           text="No class is currently running."
           styleClass="section-title"/>

    <Button text="Start Online Class"
            maxWidth="400"
            onAction="#handleStartClass"
            styleClass="primary-button"/>

    <Button text="End Online Class"
            maxWidth="400"
            onAction="#handleEndClass"/>

    <Separator/>

    <Label fx:id="cameraStatusLabel"
           text="Camera: OFF"/>

    <Button text="Toggle Camera"
            maxWidth="400"
            onAction="#handleCamera"/>

    <Label fx:id="microphoneStatusLabel"
           text="Microphone: OFF"/>

    <Button text="Toggle Microphone"
            maxWidth="400"
            onAction="#handleMicrophone"/>

    <Label fx:id="recordingStatusLabel"
           text="Recording: OFF"/>

    <Button text="Toggle Recording"
            maxWidth="400"
            onAction="#handleRecording"/>

    <Label fx:id="whiteboardStatusLabel"
           text="Whiteboard: CLOSED"/>

    <Button text="Toggle Whiteboard"
            maxWidth="400"
            onAction="#handleWhiteboard"/>

    <Separator/>

    <Button text="Back to Dashboard"
            onAction="#handleBack"/>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tutorly.controller.tutor.OnlineClassController"
      alignment="TOP_CENTER" spacing="12" prefWidth="1000" prefHeight="700" styleClass="root">
    <padding><Insets top="25" right="40" bottom="25" left="40"/></padding>
    <Label text="Tutorly Live Class" styleClass="page-title"/>
    <Label text="Choose a remaining accepted class and start it whenever you are ready." styleClass="section-title" wrapText="true"/>
    <Separator/>
    <Label text="Remaining Classes" styleClass="section-title"/>
    <ListView fx:id="classListView" prefHeight="260" maxWidth="900" VBox.vgrow="ALWAYS"/>
    <Label fx:id="classInfoLabel" text="Select a remaining class." wrapText="true"/>
    <Label fx:id="statusLabel" text="No class is currently running." wrapText="true" styleClass="section-title"/>
    <HBox spacing="10">
        <Button fx:id="startButton" text="Start Live Class" onAction="#handleStartClass" styleClass="primary-button"/>
        <Button fx:id="openButton" text="Open Classroom" onAction="#handleOpenClassroom"/>
        <Button fx:id="endButton" text="End &amp; Complete Class" onAction="#handleEndClass"/>
    </HBox>
    <Separator/>
    <GridPane hgap="15" vgap="8">
        <Label text="Camera:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="cameraStatusLabel" text="OFF" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Toggle Camera" onAction="#handleCamera" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Label text="Microphone:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="microphoneStatusLabel" text="OFF" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button text="Toggle Microphone" onAction="#handleMicrophone" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <Label text="Recording:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="recordingStatusLabel" text="OFF" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button text="Toggle Recording" onAction="#handleRecording" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <Label text="Whiteboard:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="whiteboardStatusLabel" text="CLOSED" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Button text="Toggle Whiteboard" onAction="#handleWhiteboard" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
    </GridPane>
    <Button text="Back to Dashboard" onAction="#handleBack"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tutorly.controller.student.CreateBookingController"
            styleClass="root">

    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="18"
                        right="30"
                        bottom="18"
                        left="30"/>
            </padding>

            <Button text="← Back"
                    onAction="#handleBack"
                    styleClass="text-button"/>

            <Label text="Book Tutor"
                   styleClass="app-title"/>

        </HBox>

    </top>

    <center>

        <VBox spacing="18"
              maxWidth="500"
              alignment="CENTER">

            <padding>
                <Insets top="40"
                        right="40"
                        bottom="40"
                        left="40"/>
            </padding>

            <Label text="Create Booking Request"
                   styleClass="page-title"/>

            <TextField fx:id="tutorIdField"
                       promptText="Tutor ID"/>

            <TextField fx:id="subjectIdField"
                       promptText="Subject ID"/>

            <DatePicker fx:id="datePicker"
                        promptText="Date"/>

            <ComboBox fx:id="timeComboBox"
                      promptText="Preferred time"/>

            <ComboBox fx:id="durationComboBox"
                      promptText="Duration"/>

            <Button text="Send Booking Request"
                    onAction="#handleBook"
                    styleClass="primary-button"/>

            <Label fx:id="messageLabel"
                   wrapText="true"/>

        </VBox>

    </center>

</BorderPane>

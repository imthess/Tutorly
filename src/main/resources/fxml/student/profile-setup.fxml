<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tutorly.controller.student.StudentProfileSetupController"
      alignment="CENTER"
      spacing="15"
      prefWidth="1000"
      prefHeight="700"
      styleClass="root">

    <padding>
        <Insets top="40"
                right="40"
                bottom="40"
                left="40"/>
    </padding>

    <Label text="Complete Your Student Profile"
           styleClass="page-title"/>

    <Label fx:id="welcomeLabel"
           text="Welcome"
           styleClass="section-title"/>

    <Label text="Before using Tutorly, please complete your profile."
           wrapText="true"
           alignment="center"
           maxWidth="500"/>

    <Label text="Education"/>

    <TextField fx:id="educationField"
               promptText="Example: BSc in Computer Science"
               maxWidth="500"/>

    <Label text="Institute"/>

    <TextField fx:id="instituteField"
               promptText="Example: North South University"
               maxWidth="500"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           maxWidth="500"/>

    <Button text="Save &amp; Continue"
            onAction="#handleSaveProfile"
            styleClass="primary-button"
            maxWidth="500"/>

    <Button text="Logout"
            onAction="#handleLogout"
            styleClass="text-button"/>

</VBox>
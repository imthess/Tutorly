<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tutorly.controller.student.StudentProfileSetupController"
            prefWidth="1000"
            prefHeight="700"
            styleClass="root">

    <top>

        <HBox alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="18"
                        right="30"
                        bottom="18"
                        left="30"/>
            </padding>

            <Label text="Tutorly"
                   styleClass="app-title"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    styleClass="text-button"/>

        </HBox>

    </top>


    <center>

        <VBox alignment="CENTER"
              spacing="20"
              maxWidth="650">

            <padding>
                <Insets top="40"
                        right="40"
                        bottom="40"
                        left="40"/>
            </padding>


            <Label text="Complete Your Student Profile"
                   styleClass="page-title"/>

            <Label fx:id="welcomeLabel"
                   text="Welcome"
                   styleClass="section-title"/>

            <Label text="Complete these details to personalize your Tutorly experience."
                   wrapText="true"
                   styleClass="dashboard-subtitle"/>


            <VBox spacing="8"
                  styleClass="form-card">

                <Label text="Education"
                       styleClass="field-label"/>

                <TextField fx:id="educationField"
                           promptText="Example: BSc in Computer Science"
                           maxWidth="600"/>

                <Label text="Institute"
                       styleClass="field-label"/>

                <TextField fx:id="instituteField"
                           promptText="Example: North South University"
                           maxWidth="600"/>

                <Label fx:id="messageLabel"
                       wrapText="true"
                       styleClass="error-label"/>

                <Button text="Save &amp; Continue"
                        onAction="#handleSaveProfile"
                        styleClass="primary-button"
                        maxWidth="600"/>

            </VBox>

        </VBox>

    </center>

</BorderPane>

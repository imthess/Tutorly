<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tutorly.controller.HomeController"
            prefWidth="1000"
            prefHeight="700"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="navbar">

            <Label text="Tutorly"
                   styleClass="logo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Login"
                    onAction="#handleLogin"
                    styleClass="nav-button"/>

            <Button text="Sign Up"
                    onAction="#handleSignup"
                    styleClass="primary-button"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="25">

            <padding>
                <Insets top="40"
                        right="40"
                        bottom="40"
                        left="40"/>
            </padding>

            <Label text="Find the Perfect Tutor"
                   styleClass="hero-title"/>

            <Label text="Learn online or find a private tutor for offline classes."
                   styleClass="hero-subtitle"/>

            <HBox alignment="CENTER"
                  spacing="15">

                <Button text="Get Started"
                        onAction="#handleSignup"
                        styleClass="primary-button"/>

                <Button text="Become a Tutor"
                        onAction="#handleSignup"
                        styleClass="secondary-button"/>

            </HBox>

            <Label text="Online Video Classes   •   Offline Tutoring   •   Secure Payments"
                   styleClass="feature-text"/>

        </VBox>
    </center>

    <bottom>
        <Label text="© 2026 Tutorly"
               styleClass="footer"/>
    </bottom>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tutorly.controller.SignupController"
      alignment="CENTER"
      spacing="12"
      prefWidth="1000"
      prefHeight="700"
      styleClass="root">

    <padding>
        <Insets top="30"
                right="40"
                bottom="30"
                left="40"/>
    </padding>

    <Label text="Create Your Tutorly Account"
           styleClass="page-title"/>

    <TextField fx:id="fullNameField"
               promptText="Full Name"
               maxWidth="350"/>

    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="350"/>

    <TextField fx:id="phoneField"
               promptText="Phone"
               maxWidth="350"/>

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="350"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirm Password"
                   maxWidth="350"/>

    <ComboBox fx:id="roleComboBox"
              promptText="Account Type"
              maxWidth="350"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           maxWidth="350"/>

    <Button text="Create Account"
            onAction="#handleSignup"
            maxWidth="350"
            styleClass="primary-button"/>

    <Button text="Already have an account? Login"
            onAction="#handleLogin"
            styleClass="text-button"/>

    <Button text="Back"
            onAction="#handleBack"
            styleClass="text-button"/>

</VBox>
